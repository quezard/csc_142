import pygame
import random

pygame.init()

# window stuff
w = 800
h = 600
screen = pygame.display.set_mode((w, h))
pygame.display.set_caption("Click Game")

clock = pygame.time.Clock()

# text function
def draw_text(surface, text, x, y, color, size=24):
    font = pygame.font.SysFont(None, size)
    img = font.render(text, True, color)
    surface.blit(img, (x, y))


class Ball:
    def __init__(self):
        self.r = random.randint(15, 30)

        self.x = random.randint(self.r, w - self.r)
        self.y = random.randint(self.r, h - self.r)

        self.dx = random.choice([-3, -2, 2, 3])
        self.dy = random.choice([-3, -2, 2, 3])

        self.color = (random.randint(50,255),
                      random.randint(50,255),
                      random.randint(50,255))

        self.rect = pygame.Rect(self.x - self.r,
                                self.y - self.r,
                                self.r*2,
                                self.r*2)

    def move(self):
        self.x += self.dx
        self.y += self.dy

        if self.x - self.r <= 0 or self.x + self.r >= w:
            self.dx = -self.dx

        if self.y - self.r <= 0 or self.y + self.r >= h:
            self.dy = -self.dy

        self.rect.x = self.x - self.r
        self.rect.y = self.y - self.r

    def draw(self):
        pygame.draw.circle(screen, self.color, (self.x, self.y), self.r)


balls = []
score = 0

start = pygame.time.get_ticks()
lastSeconds = 0
gameOver = False

running = True
while running:
    clock.tick(60)
    screen.fill((25, 25, 25))

    now = pygame.time.get_ticks()
    passed = now - start
    seconds = passed // 1000

    # add ball every second
    if seconds > lastSeconds:
        lastSeconds = seconds
        if not gameOver:
            balls.append(Ball())

    # stop at 15 seconds
    if seconds >= 15:
        gameOver = True
        balls = []   # just clear them all

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.MOUSEBUTTONDOWN:
            if not gameOver:
                pos = pygame.mouse.get_pos()
                for b in balls[:]:
                    if b.rect.collidepoint(pos):
                        score += 1
                        balls.remove(b)

    # move + draw balls
    if not gameOver:
        for b in balls:
            b.move()
            b.draw()

    # draw score + time
    draw_text(screen, "Score: " + str(score), 10, 10, (255,255,255), 28)
    draw_text(screen, "Time: " + str(seconds), 10, 40, (255,255,255), 28)

    if gameOver:
        draw_text(screen, "GAME OVER", w//2 - 90, h//2 - 30, (255,0,0), 50)
        draw_text(screen, "Final Score: " + str(score),
                  w//2 - 110, h//2 + 20, (255,255,255), 36)

    pygame.display.flip()

pygame.quit()

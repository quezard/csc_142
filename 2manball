import pygame
import random

pygame.init()

# Window setup
WIDTH = 800
HEIGHT = 600
window = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Click The Balls!")

clock = pygame.time.Clock()

# ----------------------------
# Helper function for drawing text
# ----------------------------
def draw_text(surface, text, x, y, color, font_size=24):
    text_font = pygame.font.SysFont(None, font_size)
    text_surface = text_font.render(text, True, color)
    text_rect = text_surface.get_rect()
    text_rect.topleft = (x, y)
    surface.blit(text_surface, text_rect)

# ----------------------------
# Ball Class
# ----------------------------
class Ball:
    def __init__(self):
        self.radius = random.randint(15, 30)
        self.x = random.randint(self.radius, WIDTH - self.radius)
        self.y = random.randint(self.radius, HEIGHT - self.radius)
        self.xSpeed = random.choice([-3, -2, 2, 3])
        self.ySpeed = random.choice([-3, -2, 2, 3])
        self.color = (random.randint(50,255), random.randint(50,255), random.randint(50,255))
        self.rect = pygame.Rect(self.x - self.radius, self.y - self.radius,
                                self.radius * 2, self.radius * 2)

    def move(self):
        self.x += self.xSpeed
        self.y += self.ySpeed

        # Bounce off walls
        if self.x - self.radius <= 0 or self.x + self.radius >= WIDTH:
            self.xSpeed *= -1
        if self.y - self.radius <= 0 or self.y + self.radius >= HEIGHT:
            self.ySpeed *= -1

        self.rect.topleft = (self.x - self.radius, self.y - self.radius)

    def draw(self, surface):
        pygame.draw.circle(surface, self.color, (self.x, self.y), self.radius)

# ----------------------------
# Game Variables
# ----------------------------
ballList = []
score = 0
lastSeconds = 0
startTime = pygame.time.get_ticks()
gameOver = False

running = True
while running:
    clock.tick(60)
    window.fill((30, 30, 30))

    currentTime = pygame.time.get_ticks()
    elapsedMilliseconds = currentTime - startTime
    secondsElapsed = elapsedMilliseconds // 1000

    # Add a new ball every second
    if secondsElapsed > lastSeconds:
        lastSeconds = secondsElapsed
        if not gameOver:
            ballList.append(Ball())

    # End game after 15 seconds
    if secondsElapsed >= 15:
        gameOver = True
        ballList.clear()

    # ----------------------------
    # Event Handling
    # ----------------------------
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.MOUSEBUTTONDOWN and not gameOver:
            mousePos = pygame.mouse.get_pos()
            for ball in ballList[:]:  # copy list to safely remove
                if ball.rect.collidepoint(mousePos):
                    score += 1
                    ballList.remove(ball)

    # ----------------------------
    # Update & Draw Balls
    # ----------------------------
    if not gameOver:
        for ball in ballList:
            ball.move()
            ball.draw(window)

    # ----------------------------
    # Draw Score and Time
    # ----------------------------
    draw_text(window, f"Score: {score}", 10, 10, (255, 255, 255), 30)
    draw_text(window, f"Time: {secondsElapsed}", 10, 45, (255, 255, 255), 30)

    # ----------------------------
    # Game Over Screen
    # ----------------------------
    if gameOver:
        draw_text(window, "GAME OVER", WIDTH//2 - 100, HEIGHT//2 - 40, (255, 0, 0), 50)
        draw_text(window, f"Final Score: {score}", WIDTH//2 - 110, HEIGHT//2 + 10, (255,255,255), 40)

    pygame.display.update()

pygame.quit()

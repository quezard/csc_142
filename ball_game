import pygame
import random

pygame.init()

screen = pygame.display.set_mode((800,600))
clock = pygame.time.Clock()

# ball stuff
radius = 25
ball = pygame.Rect(
    random.randint(0, 800 - radius*2),
    random.randint(0, 600 - radius*2),
    radius*2,
    radius*2
)

xSpeed = random.choice([-3,3])
ySpeed = random.choice([-3,3])

# timing
startTime = pygame.time.get_ticks()

score = 0
gameOver = False

# sound
success = pygame.mixer.Sound("success.wav")

font = pygame.font.SysFont(None, 36)

running = True
while running:
    screen.fill((0,0,0))

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.MOUSEBUTTONDOWN:
            if not gameOver:
                pos = event.pos

                if ball.collidepoint(pos):
                    score += 1
                    success.play()

                    # move ball somewhere random again
                    ball.x = random.randint(0, 800 - ball.width)
                    ball.y = random.randint(0, 600 - ball.height)

                    # make it faster
                    xSpeed = (abs(xSpeed) + random.randint(1,5)) * (1 if xSpeed > 0 else -1)
                    ySpeed = (abs(ySpeed) + random.randint(1,5)) * (1 if ySpeed > 0 else -1)

                    if score == 5:
                        gameOver = True
                        endTime = pygame.time.get_ticks()
                        totalTime = (endTime - startTime) / 1000

    if not gameOver:
        ball.x += xSpeed
        ball.y += ySpeed

        # bounce
        if ball.left <= 0 or ball.right >= 800:
            xSpeed = -xSpeed
        if ball.top <= 0 or ball.bottom >= 600:
            ySpeed = -ySpeed

        pygame.draw.ellipse(screen, (255,0,0), ball)

        # draw score
        scoreText = font.render("Score: " + str(score), True, (255,255,255))
        screen.blit(scoreText, (10,10))

    else:
        msg = font.render(
            "You clicked 5 times in " + str(round(totalTime,2)) + " seconds!",
            True,
            (255,255,255)
        )
        msgRect = msg.get_rect(center=(400,300))
        screen.blit(msg, msgRect)

    pygame.display.flip()
    clock.tick(60)

pygame.quit()
